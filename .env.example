# ---------------------------------------------------------------------------
# エージェントエージェント 環境変数
# このファイルを .env にコピーして値を設定してください。
# ---------------------------------------------------------------------------

# PostgreSQL の接続文字列(docker compose を使う場合はこのままで動きます)
# Supabase では Transaction pooler(ポート 6543)の接続文字列を使う
DATABASE_URL="postgresql://agentagent:agentagent@localhost:5432/agentagent?schema=public"

# マイグレーション用の接続文字列(Supabase では Session pooler、ポート 5432 に ?sslmode=require を付ける)
# 未設定なら DATABASE_URL を使う
# DIRECT_URL=""

# アプリの DB 接続の TLS: verify / no-verify / disable(未設定なら接続文字列の指定に従う)
# Supabase では no-verify(暗号化するが独自 CA の証明書は検証しない)。verify の場合は DATABASE_CA_CERT に PEM を入れる
# DATABASE_SSL=""
# DATABASE_CA_CERT=""
# 1インスタンスあたりの DB 接続数の上限
# DATABASE_POOL_MAX=5

# アプリの公開 URL(Google OAuth のリダイレクト先に使います)
APP_URL="http://localhost:3000"

# OAuth トークンの暗号化鍵。`openssl rand -base64 32` で生成してください
APP_ENCRYPTION_KEY=""

# Google Cloud Console で作成した OAuth クライアント(Gmail API を有効化しておくこと)
# リダイレクト URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ログインを許可する Google アカウント(カンマ区切り)
# 開発環境で未設定なら全員を許可、本番環境(NODE_ENV=production)で未設定なら全員を拒否
ALLOWED_GOOGLE_EMAILS=""

# Anthropic API キー
ANTHROPIC_API_KEY=""
# 使用するモデルと effort(省略可)
AGENTAGENT_MODEL="claude-opus-5-5"
AGENTAGENT_DRAFT_EFFORT="medium"
AGENTAGENT_ANALYSIS_EFFORT="low"

# cron エンドポイント(/api/cron/tick)の認証シークレット。`openssl rand -hex 32` で生成
CRON_SECRET=""

# 開発用ログイン(本番では無効)。true にすると /login にデモユーザーでのログインが出ます
DEV_LOGIN_ENABLED="false"

# Gmail 同期の調整(省略可)
# GMAIL_SYNC_QUERY="-in:spam -in:trash -in:chats"
# 初回の取り込み範囲(日)
# GMAIL_SYNC_LOOKBACK_DAYS=30
# 1回の同期で一覧取得するメールの上限
# GMAIL_SYNC_MAX_MESSAGES=5000
# 1回の同期で AI に送信者を判定させる上限(超えた分は次回)
# SENDER_CHECKS_PER_SYNC=40
# Gmail API の 1 ユーザーあたり 1 分あたりの利用上限(単位)。2026 年 5 月以降に作った Google Cloud プロジェクトは 6,000、
# それより前のプロジェクトは 15,000。Google Cloud コンソールの「割り当て」で確認できる。同期はこの 75% まで使う
# GMAIL_QUOTA_UNITS_PER_MINUTE=6000

# 定期処理の調整(省略可)
# 1回の定期処理に使える時間(秒)。超えた分は次回に回す
# TICK_TIME_BUDGET_SECONDS=240
# 受信からこの時間(時間)以上経ったメールへの返信は、運用モードに関係なく承認制にする
# STALE_REPLY_HOURS=72
# 受信からこの日数以上経ったメールには返信案を作らない(分類と案件の登録だけ行う)
# REPLY_DRAFT_MAX_AGE_DAYS=7
# ワーカー(npm run worker)の実行間隔(秒)
# SYNC_INTERVAL_SECONDS=300
