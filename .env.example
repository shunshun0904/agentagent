# ---------------------------------------------------------------------------
# エージェントエージェント 環境変数
# このファイルを .env にコピーして値を設定してください。
# ---------------------------------------------------------------------------

# PostgreSQL の接続文字列(docker compose を使う場合はこのままで動きます)
DATABASE_URL="postgresql://agentagent:agentagent@localhost:5432/agentagent?schema=public"

# アプリの公開 URL(Google OAuth のリダイレクト先に使います)
APP_URL="http://localhost:3000"

# OAuth トークンの暗号化鍵。`openssl rand -base64 32` で生成してください
APP_ENCRYPTION_KEY=""

# Google Cloud Console で作成した OAuth クライアント(Gmail API を有効化しておくこと)
# リダイレクト URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ログインを許可する Google アカウント(カンマ区切り)。未設定なら全員を許可
ALLOWED_GOOGLE_EMAILS=""

# Anthropic API キー
ANTHROPIC_API_KEY=""
# 使用するモデルと effort(省略可)
AGENTAGENT_MODEL="claude-opus-5-5"
AGENTAGENT_DRAFT_EFFORT="medium"
AGENTAGENT_ANALYSIS_EFFORT="low"

# cron エンドポイント(/api/cron/tick)の認証シークレット。`openssl rand -hex 32` で生成
CRON_SECRET=""

# 開発用ログイン(本番では無効)。true にすると /login にデモユーザーでのログインが出ます
DEV_LOGIN_ENABLED="false"

# Gmail 同期の調整(省略可)
# GMAIL_SYNC_QUERY="-in:spam -in:trash -in:chats"
# GMAIL_SYNC_LOOKBACK_DAYS=14
# GMAIL_SYNC_MAX_MESSAGES=200
# SENDER_CHECKS_PER_SYNC=40
# ワーカーの実行間隔(秒)
# SYNC_INTERVAL_SECONDS=300
